{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure macOS Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "macos-debug"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build macOS Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "macos-debug"
            ],
            "group": {
                "kind": "build",
