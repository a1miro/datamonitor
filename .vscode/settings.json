{
    // Qt Configuration
    // Update these paths to match your Qt installation:
    // - For Qt installed via Qt Online Installer: ~/Qt/6.x/gcc_64/
    // - For system package manager: /usr/include/qt6/ or /usr/include/qt6/
    // - For custom installation: adjust paths accordingly

    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.generator": "Unix Makefiles",
    "cmake.buildToolArgs": [
        "-j8"
    ],
    "files.associations": {
        "*.qml": "qml",
        "*.h": "cpp",
        "*.cpp": "cpp"
    },
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/src",
        "${env:HOME}/Qt/6.*/gcc_64/include",
        "${env:HOME}/Qt/6.*/gcc_64/include/QtCore",
        "${env:HOME}/Qt/6.*/gcc_64/include/QtQuick",
        "${env:HOME}/Qt/6.*/gcc_64/include/QtQml",
        "${env:HOME}/Qt/6.*/gcc_64/include/QtGui",
        "/usr/include/qt6",
        "/usr/include/qt6/QtCore",
        "/usr/include/qt6/QtQuick",
        "/usr/include/qt6/QtQml",
        "/usr/include/qt6/QtGui"
    ],
    "qt-for-python.qml.languageServer.enabled": true,
    "qmlls.enabled": true,
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
        "**/build": true,
        "**/build-*": true,
        "**/.git": true,
        "**/node_modules": true
    },
    "files.exclude": {
        "**/build": true,
        "**/build-*": true,
        "**/.git": true,
        "**/node_modules": true,
        "**/.qt": true,
        "**/.rcc": true,
        "**/CMakeCache.txt": true,
        "**/CMakeFiles": true,
        "**/cmake_install.cmake": true,
        "**/compile_commands.json": false
    },
    "C_Cpp.files.exclude": {
        "**/build/**": true,
        "**/build-*/**": true,
        "**/.qt/**": true,
        "**/.rcc/**": true,
        "**/CMakeFiles/**": true
    },
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.intelliSenseEngineFallback": "disabled",
    "cmake.configureArgs": [
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
}
