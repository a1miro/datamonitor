{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug DataMonitor",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/datamonitor",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QML_IMPORT_PATH",
                    "value": "${workspaceFolder}/build"
                },
                {
                    "name": "QT_QPA_PLATFORM",
                    "value": "xcb"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build DataMonitor",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "moduleLoad": false,
                "trace": false,
                "engineLogging": false,
                "programOutput": true,
                "exceptions": true
            }
        },
        {
            "name": "Release DataMonitor",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/datamonitor",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QML_IMPORT_PATH",
                    "value": "${workspaceFolder}/build"
                },
                {
                    "name": "QT_QPA_PLATFORM",
                    "value": "xcb"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build DataMonitor Release"
        },
        {
            "name": "Attach to DataMonitor",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/datamonitor",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
