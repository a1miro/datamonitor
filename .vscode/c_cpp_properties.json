{
    "version": 4,
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/build/**",
                "${env:HOME}/Qt/6.*/gcc_64/include/**",
                "${env:HOME}/Qt/6.*/gcc_64/include",
                "${env:HOME}/Qt/6.*/gcc_64/include/QtCore",
                "${env:HOME}/Qt/6.*/gcc_64/include/QtQuick",
                "${env:HOME}/Qt/6.*/gcc_64/include/QtQml",
                "${env:HOME}/Qt/6.*/gcc_64/include/QtGui",
                "${env:HOME}/Qt/6.*/gcc_64/include/QtWidgets",
                "/usr/include/qt6/**",
                "/usr/include/qt6",
                "/usr/include/qt6/QtCore",
                "/usr/include/qt6/QtQuick",
                "/usr/include/qt6/QtQml",
                "/usr/include/qt6/QtGui",
                "/usr/include/qt6/QtWidgets",
                "/usr/include/x86_64-linux-gnu/qt6/**",
                "/usr/include/c++/**",
                "/usr/include/**"
            ],
            "defines": [
                "QT_CORE_LIB",
                "QT_QUICK_LIB",
                "QT_QML_LIB",
                "QT_GUI_LIB",
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ]
}
